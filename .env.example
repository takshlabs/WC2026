# football-data.org free tier API key
# Sign up at: https://www.football-data.org/client/register
# Then copy this file to .env and paste your key below

VITE_FOOTBALL_DATA_KEY=your_key_here

# Firebase Realtime Database — all-time visitor counter
# 1. Create a free project at https://console.firebase.google.com
# 2. Enable Realtime Database (Start in test mode, or set rules below)
# 3. Add these three values from Project Settings > General > Your apps > SDK config
#
# Recommended DB rules (Realtime Database > Rules tab):
# {
#   "rules": {
#     "wc2026": { ".read": true, ".write": true }
#   }
# }
#
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_DB_URL=https://your-project-default-rtdb.firebaseio.com
